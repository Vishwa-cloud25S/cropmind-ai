# ─────────────────────────────────────────────────────────────
# CropMind AI environment template.
# Copy to .env and fill in local values. NEVER commit the real .env.
# No real keys belong in version control — rotate anything ever exposed.
# ─────────────────────────────────────────────────────────────

APP_ENV=development
API_PORT=8000

# Database (local PostgreSQL from docker-compose)
POSTGRES_USER=cropmind
POSTGRES_PASSWORD=cropmind-local-only
POSTGRES_DB=cropmind
DATABASE_URL=postgresql+psycopg://cropmind:cropmind-local-only@localhost:5432/cropmind

# Auth (Phase 10 — live: /auth/register|login|logout|me; JWT + bcrypt).
# JWT_SECRET_KEY unset or left as the placeholder => an EPHEMERAL per-boot secret is
# used (loud startup warning; tokens simply die on restart — fine for local dev).
# Generate a long random string for any non-local use:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-local-development-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# REFRESH_TOKEN_EXPIRE_DAYS is RESERVED — no refresh tokens are issued yet (post-MVP);
# re-login is the honest current behaviour.
# First registered account on a fresh DB becomes ADMIN (documented bootstrap);
# later accounts are FARMER; admins promote roles via /admin.
# AUTH_REQUIRED=false exists only for fully-local trusted dev rigs.
AUTH_REQUIRED=true

# Rate limiting (Phase 10) — in-memory per-IP sliding window, single API instance;
# 429 carries Retry-After. A shared store slots in for multi-replica deploys.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=120

# CORS
CORS_ORIGINS=http://localhost:3000

# Uploads pipeline (Phase 5) — images are validated by MAGIC BYTES, not this list
# or file extensions (see backend/app/services/uploads.py)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
UPLOAD_MAX_SIDE=2048
UPLOAD_THUMB_SIDE=384

# ML worker (Phase 5) — worker process only; the API never imports torch.
# MODEL_CHECKPOINT: path to a trained checkpoint INSIDE the worker container.
#   docker-compose: ./runs is mounted read-only at /runs, so e.g.
#     MODEL_CHECKPOINT=/runs/20260808-180238-0.1.0/checkpoint.pt
#   local dev (repo root as cwd): MODEL_CHECKPOINT=runs/20260808-180238-0.1.0/checkpoint.pt
# Leave EMPTY to use the clearly-flagged DEMO sample model (synthetic patterns,
# generated once deterministically; every prediction it makes is flagged demo).
MODEL_CHECKPOINT=

# Worker queue behaviour (DB-backed queue, ADR-004)
WORKER_POLL_INTERVAL_S=2.0
JOB_MAX_ATTEMPTS=3
JOB_HEARTBEAT_TIMEOUT_S=120
JOB_RETRY_BACKOFF_S=10.0

# Confidence bands & model thresholds are ML configuration, not app env:
# see ml/configs/model.yaml (thresholds) and ml/configs/taxonomy.yaml (classes).

# Demo mode: serves bundled sample imagery and allows unauthenticated demo analysis
DEMO_MODE=true

# Frontend (build-time): where the browser reaches the API
NEXT_PUBLIC_API_URL=http://localhost:8000
