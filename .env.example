# ─────────────────────────────────────────────────────────────
# CropMind AI environment template.
# Copy to .env and fill in local values. NEVER commit the real .env.
# No real keys belong in version control — rotate anything ever exposed.
# ─────────────────────────────────────────────────────────────

APP_ENV=development
API_PORT=8000

# Database (local PostgreSQL from docker-compose)
POSTGRES_USER=cropmind
POSTGRES_PASSWORD=cropmind-local-only
POSTGRES_DB=cropmind
DATABASE_URL=postgresql+psycopg://cropmind:cropmind-local-only@localhost:5432/cropmind

# Auth — generate a long random string for any non-local use:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-local-development-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000

# Uploads / image pipeline
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/tiff

# ML pipeline
MODEL_CONFIG_PATH=ml/configs/model.yaml
MODEL_CHECKPOINT_PATH=ml/models/pretrained/
# Confidence bands are configuration, not hardcoded (see ml/configs/model.yaml)
HIGH_CONFIDENCE_THRESHOLD=0.60
MEDIUM_CONFIDENCE_THRESHOLD=0.45
LOW_CONFIDENCE_THRESHOLD=0.25

# Demo mode: serves bundled sample imagery and allows unauthenticated demo analysis
DEMO_MODE=true

# Frontend (build-time): where the browser reaches the API
NEXT_PUBLIC_API_URL=http://localhost:8000
